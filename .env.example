# Polymarket CLOB API credentials
POLY_PRIVATE_KEY=0x...
POLY_API_KEY=...
POLY_API_SECRET=...
POLY_API_PASSPHRASE=...
POLY_FUNDER_ADDRESS=0x...

# Bot configuration
STARTING_BANKROLL=100.0
BOT_MODE=dry_run              # dry_run | paper | live
ACTIVE_STRATEGIES=endcycle_sniper,pair_cost_avg
MARKET_TYPE=5m                # 5m | 15m
CONFIRM_LIVE=no               # Must be "yes" for live trading

# Risk limits
MAX_BET_FRACTION=0.10         # Max 10% of bankroll per trade
MAX_DAILY_LOSS_FRACTION=0.20  # Stop trading at 20% daily loss
MIN_BANKROLL=20.0             # Stop trading below this

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Logging
LOG_LEVEL=INFO
DB_PATH=trades.db
